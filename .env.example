# ─────────────────────────────────────────────────────────────
# Vortex Metrics — local development environment
# Copy this file to .env and adjust if needed.
# ─────────────────────────────────────────────────────────────

# Pooled / application connection (runtime).
# RLS is enforced for a non-superuser role. Neon's default role qualifies;
# the local `postgres` superuser bypasses RLS, so `npm run db:rls` proves the
# policies with a temporary non-superuser role instead.
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/vortex_metrics?schema=public"

# Direct connection used by the Prisma CLI for migrations.
# On Neon this is the non-pooled host (without "-pooler").
DIRECT_URL="postgresql://postgres:postgres@localhost:5434/vortex_metrics?schema=public"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Public demo mode. When enabled, the login page advertises the seeded account
# (demo@vortex.test / vortex-demo-1) and offers a one-click sign-in.
# `npm run db:seed` provisions Acme Inc and Nordwind Studio for it.
# DEMO_MODE="true"
# DEMO_READ_ONLY="true"

# Optional transactional email (password resets / invitations).
# Without it, reset and invite links are surfaced in the admin UI in demo mode.
# RESEND_API_KEY=""
# EMAIL_FROM="Vortex Metrics <no-reply@example.com>"

# Protects /api/cron/* endpoints (demo reseed, housekeeping).
# CRON_SECRET=""
